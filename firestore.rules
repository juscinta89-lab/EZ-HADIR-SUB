rules_version = '2';

/* ══════════════════════════════════════════════════════════════
   EZ-HADIR — Firestore Security Rules (berbilang sekolah)

   SEBELUM PUBLISH: tukar emel dalam fungsi pemilik() kepada emel
   anda. Ia mesti sama dengan CONFIG.PEMILIK dalam index.html.

   Tiada indeks manual diperlukan oleh rules ini.

   Peranan:
   • Pemilik produk  → semua sekolah, cipta dan tamatkan langganan
   • Admin sekolah   → data sekolah sendiri sahaja, baca dan tulis
   • Guru            → data sekolah sendiri sahaja, baca sahaja
   • Orang lain      → tiada akses
   ══════════════════════════════════════════════════════════════ */

service cloud.firestore {
  match /databases/{database}/documents {

    function masuk() {
      return request.auth != null && request.auth.token.email != null;
    }
    function emel() { return request.auth.token.email.lower(); }

    // GANTI dengan emel anda
    function pemilik() {
      return masuk() && emel() in [
        'juscinta89@gmail.com'
      ];
    }

    // Baris pendaftaran pengguna yang sedang log masuk
    function saya() {
      return get(/databases/$(database)/documents/pengguna/$(emel())).data;
    }
    function berdaftar() {
      return masuk() && exists(/databases/$(database)/documents/pengguna/$(emel()));
    }
    function ahli(sid)  { return berdaftar() && saya().sid == sid; }
    function adminSekolah(sid) { return ahli(sid) && saya().peranan == 'admin'; }

    // Langganan: sekolah mesti aktif dan belum tamat
    function sekolahHidup(sid) {
      let s = get(/databases/$(database)/documents/sekolah/$(sid)).data;
      return s.aktif == true
          && (!('tamat' in s) || s.tamat == null || request.time < s.tamat);
    }

    /* ── pautan jemputan ───────────────────────────────────── */
    // Kod jemputan itu sendiri ialah rahsia. Sesiapa yang log masuk
    // boleh membacanya JIKA tahu kodnya, tetapi tidak boleh menyenaraikan
    // semua kod. Hanya admin sekolah boleh mencipta dan membatalkan.
    function jemputan(kod) {
      return get(/databases/$(database)/documents/jemputan/$(kod)).data;
    }
    function jemputanSah(kod, sid, peranan) {
      return kod is string
          && exists(/databases/$(database)/documents/jemputan/$(kod))
          && jemputan(kod).sid == sid
          && jemputan(kod).peranan == peranan
          && jemputan(kod).aktif == true
          && (jemputan(kod).tamat == null || request.time < jemputan(kod).tamat);
    }

    match /jemputan/{kod} {
      allow get:    if masuk();
      allow list:   if pemilik() || adminSekolah(resource.data.sid);
      allow create: if masuk()
                    && request.resource.data.peranan in ['admin','guru']
                    && (pemilik() || adminSekolah(request.resource.data.sid));
      allow update, delete: if pemilik() || adminSekolah(resource.data.sid);
    }

    /* ── pendaftaran pengguna ──────────────────────────────── */
    match /pengguna/{emelPengguna} {
      // seorang boleh baca barisnya sendiri; admin boleh baca
      // baris sekolahnya; pemilik boleh baca semua
      allow read: if masuk() && (
                       emelPengguna == emel()
                    || pemilik()
                    || adminSekolah(resource.data.sid)
                  );

      // Ditambah oleh admin, ATAU didaftar sendiri melalui pautan jemputan
      allow create, update: if masuk()
                    && request.resource.data.emel == emelPengguna
                    && request.resource.data.peranan in ['admin','guru']
                    && (
                         pemilik()
                      || adminSekolah(request.resource.data.sid)
                      || (
                           emelPengguna == emel()
                        && jemputanSah(request.resource.data.kod,
                                       request.resource.data.sid,
                                       request.resource.data.peranan)
                         )
                    );

      allow delete: if masuk() && (pemilik() || adminSekolah(resource.data.sid));
    }

    /* ── sekolah dan datanya ───────────────────────────────── */
    match /sekolah/{sid} {
      // maklumat asas boleh dibaca ahli walaupun langganan tamat,
      // supaya app boleh papar sebab akses disekat
      allow read:   if ahli(sid) || pemilik();
      allow create, delete: if pemilik();
      // admin hanya boleh kemas kini kiraan kelas, bukan status langganan
      allow update: if pemilik()
                    || (adminSekolah(sid)
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['bilKelas']));

      match /kelas/{kelasId} {
        allow read:   if pemilik() || (ahli(sid) && sekolahHidup(sid));
        allow write:  if (pemilik() || (adminSekolah(sid) && sekolahHidup(sid)))
                      && request.resource.data.nama is string
                      && request.resource.data.murid is list
                      && request.resource.data.murid.size() <= 300;
        allow delete: if pemilik() || adminSekolah(sid);
      }

      match /rekod/{rekodId} {
        // guru boleh baca dan tulis rekod kehadiran sekolahnya
        allow read:   if pemilik() || (ahli(sid) && sekolahHidup(sid));
        allow create, update: if (pemilik() || (ahli(sid) && sekolahHidup(sid)))
                      && request.resource.data.kelas is string
                      && request.resource.data.tarikh is string
                      && request.resource.data.jumlah is int
                      && request.resource.data.hadir is int;
        allow delete: if pemilik() || adminSekolah(sid);
      }

      match /token/{tokenId} {
        // setiap pengguna hanya urus token perantinya sendiri.
        // Cloud Functions guna Admin SDK dan tidak terikat pada rules ini.
        allow read, delete: if pemilik()
                            || adminSekolah(sid)
                            || (ahli(sid) && resource.data.emel == emel());
        allow create, update: if ahli(sid)
                              && request.resource.data.emel == emel()
                              && request.resource.data.sid == sid
                              && request.resource.data.token is string;
      }

      match /tetapan/{docId} {
        allow read:  if pemilik() || (ahli(sid) && sekolahHidup(sid));
        allow write: if pemilik() || (adminSekolah(sid) && sekolahHidup(sid));
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
